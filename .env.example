# Local: manage.py usa app.settings.dev. Production: configure DJANGO_SETTINGS_MODULE=app.settings.prod.
# Não use valores reais neste arquivo; preencha no ambiente de implantação, fora do Git.
DJANGO_SETTINGS_MODULE=app.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
DATABASE_URL=
REDIS_URL=
PRIVATE_DOCUMENT_ROOT=
OSRM_URL=
GEOCODING_URL=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Docker Compose: POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB precisam coincidir com DATABASE_URL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Opcional: dev usa SQLite sem DATABASE_URL, layer em memória sem REDIS_URL e e-mail no console sem EMAIL_HOST.
FRONTEND_URL=
FRONTEND_ADMIN_URL=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CLOUDINARY_URL=
EMAIL_PORT=587
EMAIL_TIMEOUT=15
EMAIL_TOKEN_EXPIRATION_MINUTES=15
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_SECONDS=60
LOCATION_MAX_AGE_SECONDS=30
LOCATION_MIN_INTERVAL_SECONDS=2
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MAX_ATTEMPTS=2
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_ATTEMPTS=2
OSRM_MAX_STOPS=20
OSRM_MAX_SNAP_DISTANCE_METERS=100
OSRM_CACHE_TIMEOUT_SECONDS=3600
