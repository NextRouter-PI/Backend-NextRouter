# Inventário de PRODUÇÃO. Nenhum perfil lê .env automaticamente.
# Configure o ambiente explicitamente, fora do Git; não grave segredos aqui.
# Desenvolvimento não precisa deste arquivo: pdm run dev usa defaults locais.
DJANGO_SETTINGS_MODULE=app.settings.prod
SECRET_KEY=
ALLOWED_HOSTS=
# Única origem pública HTTPS, sem caminho/barra final. CORS fica vazio.
PUBLIC_ORIGIN=
PORT=8000
DATABASE_URL=
REDIS_URL=
PRIVATE_DOCUMENT_ROOT=
OSRM_URL=
GEOCODING_URL=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
CLOUDINARY_URL=
EMAIL_PORT=587
EMAIL_TIMEOUT=15
EMAIL_TOKEN_EXPIRATION_MINUTES=15
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_SECONDS=60
LOCATION_MAX_AGE_SECONDS=30
LOCATION_MIN_INTERVAL_SECONDS=2
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MAX_ATTEMPTS=2
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_ATTEMPTS=2
OSRM_MAX_STOPS=20
OSRM_MAX_SNAP_DISTANCE_METERS=100
OSRM_CACHE_TIMEOUT_SECONDS=3600

# Somente true atrás de borda controlada que sobrescreve headers encaminhados.
TRUST_PROXY_HEADERS=false
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Revisão Git completa, correspondente ao manifesto preparado do frontend.
BACKEND_REVISION=
# Worker supervisionado: todos explícitos, sem defaults operacionais.
WORKER_COMPANY_ID=
WORKER_LEASE_SECONDS=
WORKER_MAX_ATTEMPTS=
WORKER_RETRY_SECONDS=
WORKER_POLL_SECONDS=
WORKER_SCHEDULE_BATCH_SIZE=
WORKER_MAINTENANCE_BATCH_SIZE=
WORKER_JOB_BATCH_SIZE=

# Overrides DEV_* opcionais, definidos no ambiente do terminal, não neste arquivo.
# Sem overrides: dev.sqlite3, dev-media/, dev-private-documents/, e-mail no console.
# DEV_DATABASE_PATH=/caminho/absoluto/novo.sqlite3
# DEV_MEDIA_ROOT=/caminho/absoluto/media
# DEV_PRIVATE_DOCUMENT_ROOT=/caminho/absoluto/private
# DEV_FRONTEND_ORIGIN=http://127.0.0.1:5173
# DEV_SECRET_KEY=chave-somente-local
# DEV_OSRM_URL=                  # Somente serviço explicitamente autorizado.
# DEV_GEOCODING_URL=
# DEV_LAN_HOST é definido pelo launcher pdm run dev-lan <IPv4>.
