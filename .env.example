# Local: manage.py usa app.settings.dev. Production: configure DJANGO_SETTINGS_MODULE=app.settings.prod.
# Não use valores reais neste arquivo; preencha no ambiente de implantação, fora do Git.
DJANGO_SETTINGS_MODULE=app.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=
# Produção: única origem pública HTTPS, sem caminho/barra final. CORS fica vazio.
PUBLIC_ORIGIN=
# Desenvolvimento: vazio usa SQLite em <raiz do backend>/db.sqlite3.
# PostgreSQL para testes: exporte DATABASE_URL no terminal; ao terminar, unset DATABASE_URL.
# Produção/Compose: configure uma URL PostgreSQL com as credenciais do ambiente.
DATABASE_URL=
REDIS_URL=
PRIVATE_DOCUMENT_ROOT=
OSRM_URL=
GEOCODING_URL=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Docker Compose: POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB precisam coincidir com DATABASE_URL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Opcional: dev usa SQLite sem DATABASE_URL, layer em memória sem REDIS_URL e e-mail no console sem EMAIL_HOST.
FRONTEND_URL=
FRONTEND_ADMIN_URL=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CLOUDINARY_URL=
EMAIL_PORT=587
EMAIL_TIMEOUT=15
EMAIL_TOKEN_EXPIRATION_MINUTES=15
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_SECONDS=60
LOCATION_MAX_AGE_SECONDS=30
LOCATION_MIN_INTERVAL_SECONDS=2
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MAX_ATTEMPTS=2
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_ATTEMPTS=2
OSRM_MAX_STOPS=20
OSRM_MAX_SNAP_DISTANCE_METERS=100
OSRM_CACHE_TIMEOUT_SECONDS=3600

# Produção: somente true atrás de borda controlada que sobrescreve headers encaminhados.
TRUST_PROXY_HEADERS=false
# Aumentar HSTS após validar HTTPS. Não assumir controle de subdomínios/preload do provedor.
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Release: revisão Git completa, correspondente ao manifesto preparado do frontend.
BACKEND_REVISION=
# Compose/proxy de referência local. Certificados e chave ficam fora do Git/imagem.
HTTPS_PORT=
TLS_DIRECTORY=
# Pode fixar as imagens por digest na revisão do release.
PYTHON_IMAGE=python:3.13.11-slim-bookworm
NGINX_IMAGE=nginx:stable-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# Worker supervisionado: todos explícitos; não preencha com dados reais neste exemplo.
WORKER_COMPANY_ID=
WORKER_LEASE_SECONDS=
WORKER_MAX_ATTEMPTS=
WORKER_RETRY_SECONDS=
WORKER_POLL_SECONDS=
WORKER_SCHEDULE_BATCH_SIZE=
WORKER_MAINTENANCE_BATCH_SIZE=
WORKER_JOB_BATCH_SIZE=
