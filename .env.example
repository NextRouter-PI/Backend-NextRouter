# Configuração opcional do desenvolvimento: copie para .env e preencha apenas o necessário.
# O dev lê backend/.env: valores preenchidos prevalecem sobre o terminal; vazios são ignorados.
# Sem .env, variáveis exportadas no terminal continuam disponíveis. Não versione segredos.
# ATENÇÃO: URLs preenchidas podem conectar a bancos e serviços reais. Confira antes de iniciar.
# Produção não lê .env automaticamente: configure as variáveis no ambiente do processo.
# `pdm run dev` seleciona desenvolvimento; o arquivo não escolhe o ambiente.

# Chave de sessão/assinatura. Dev tem chave local; produção exige >=50 caracteres seguros.
SECRET_KEY=
# Hosts separados por vírgula (produção obrigatória, sem *). Em dev use o comando dev-lan.
ALLOWED_HOSTS=
# Origem pública HTTPS de produção, sem caminho ou barra final; host em ALLOWED_HOSTS.
PUBLIC_ORIGIN=
# Origem HTTP local do frontend em dev; host local ou IPv4 autorizado pelo dev-lan.
FRONTEND_URL=
# Porta do launcher web de produção (1–65535); dev usa 8000.
PORT=8000

# Banco: vazio usa backend/dev.sqlite3 em dev. Produção exige URL PostgreSQL completa.
# Se SUPABASE_DATABASE_URL (ou DATABASE_URL apontando para Supabase) for informada,
# o backend conecta ao PostgreSQL do Supabase com SSL e compatibilidade com Supavisor/PgBouncer.
# Exemplo SQLite: sqlite:////caminho/absoluto/para/banco.sqlite3
# Exemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DATABASE_URL=
# Cache/canais: vazio usa memória local (um processo). Informe redis:// ou rediss:// para múltiplos processos.
REDIS_URL=
# Imagens locais em dev: vazio usa backend/dev-media/; MEDIA_ROOT não configura produção.
# Cloudinary, se preenchido, substitui o storage local nos dois perfis.
MEDIA_ROOT=
CLOUDINARY_URL=
# Documentos privados: caminho absoluto fora de mídia/estáticos/frontend.
# Em dev, vazio usa backend/dev-private-documents/; em prod, vazio usa /tmp/nextrouter-private-documents.
PRIVATE_DOCUMENT_ROOT=

# Serviços HTTP(S) autorizados para rotas/geocodificação. Vazios desativam o serviço externo;
# quando preenchidos, produção exige URLs válidas, sem credenciais/query ou provedores demo públicos.
OSRM_URL=
GEOCODING_URL=
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_ATTEMPTS=2
OSRM_MAX_STOPS=20
OSRM_MAX_SNAP_DISTANCE_METERS=100
OSRM_CACHE_TIMEOUT_SECONDS=3600
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MAX_ATTEMPTS=2

# E-mail: sem EMAIL_HOST, escreve no console; com EMAIL_HOST configurado usa SMTP (exigindo usuário e senha).
# Defina EMAIL_USE_TLS=True conforme o servidor.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_PORT=587
EMAIL_TIMEOUT=15
# Vazio usa o usuário SMTP ou um remetente local de desenvolvimento.
DEFAULT_FROM_EMAIL=
EMAIL_TOKEN_EXPIRATION_MINUTES=15
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_SECONDS=60
LOCATION_MAX_AGE_SECONDS=30
LOCATION_MIN_INTERVAL_SECONDS=2

# Produção: confiar em headers somente atrás de uma borda controlada (no Render é ativado automaticamente).
TRUST_PROXY_HEADERS=false
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Revisão Git completa do backend para verificação opcional do artefato de release.
BACKEND_REVISION=

# Worker de rotas: por padrão processa todas as empresas aprovadas com limites seguros (lease=60s, poll=5s).
# Defina WORKER_COMPANY_ID apenas se quiser restringir o worker a uma única empresa.
WORKER_ALL_COMPANIES=true
WORKER_COMPANY_ID=
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=15
WORKER_POLL_SECONDS=5
WORKER_SCHEDULE_BATCH_SIZE=20
WORKER_MAINTENANCE_BATCH_SIZE=20
WORKER_JOB_BATCH_SIZE=10
